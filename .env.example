# Kopiere diese Datei zu ".env" und trage deinen echten Key ein.
# Die .env wird NICHT in Git eingecheckt (siehe .gitignore).

# Dein OpenAI API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: welches Modell den Fakten-Check macht (Standard: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: Port des Backend-Servers (Standard: 3001)
PORT=3001
